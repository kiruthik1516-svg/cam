# Enforce LF line endings across all checkouts to prevent CRLF churn (H7)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.onnx binary
*.pt binary
*.pth binary
*.weights binary
